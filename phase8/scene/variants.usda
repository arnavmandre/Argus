#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World" (
    variants = {
        string demoState = "Stressed"
    }
    prepend variantSets = "demoState"
)
{
    variantSet "demoState" = {
        "Intervention" (
            prepend references = @../states/intervention/main.usda@
        ) {

        }
        "Stressed" (
            prepend references = @../states/stressed/main.usda@
        ) {

        }
    }
}

