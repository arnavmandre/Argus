#usda 1.0
(
    defaultPrim = "World"
    doc = """UrbanTwin presentation lighting.

    Overrides the Phase 1 environment lights with a low sun that casts real
    shadows across the street network. This is deliberate: the project demos a
    HEAT and SHADE simulation, so shade must be visible in the geometry before
    any data is overlaid. Sun elevation is ~40 degrees, which throws shadows
    long enough to read at the overview camera without flattening street level.

    Switch between scenario moods with presentation/set_scenario.py."""
    metersPerUnit = 1
    upAxis = "Z"
)

over "World"
{
    over "Environment"
    {
        over "Sun" (
            prepend apiSchemas = ["ShadowAPI"]
        )
        {
            float inputs:angle = 0.53
            color3f inputs:color = (1, 0.95, 0.85)
            float inputs:intensity = 4200
            float inputs:shadow:distance = 2000
            bool inputs:shadow:enable = 1
            float3 xformOp:rotateXYZ = (50, 0, -35)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        over "Sky"
        {
            color3f inputs:color = (0.75, 0.83, 1)
            float inputs:intensity = 180
        }
    }
}

