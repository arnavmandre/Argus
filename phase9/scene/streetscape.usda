#usda 1.0
(
    defaultPrim = "World"
    doc = "Street trees and lamps at their surveyed OSM positions, drawn as point instancers. Regenerate with phase9/place_trees.py."
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Scope "Phase9Streetscape"
    {
        custom string urbantwin:note = "511 trees and 39 lamps from surveyed OSM node positions. Visual only; the simulator's shade values are not derived from these."

        def "Looks"
        {
            def Material "Bark"
            {
                token outputs:surface.connect = </World/Phase9Streetscape/Looks/Bark/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.271, 0.208, 0.157)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.9
                    token outputs:surface
                }
            }

            def Material "Canopy"
            {
                token outputs:surface.connect = </World/Phase9Streetscape/Looks/Canopy/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.216, 0.373, 0.204)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.88
                    token outputs:surface
                }
            }

            def Material "CanopyLight"
            {
                token outputs:surface.connect = </World/Phase9Streetscape/Looks/CanopyLight/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.286, 0.447, 0.239)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.88
                    token outputs:surface
                }
            }

            def Material "LampPost"
            {
                token outputs:surface.connect = </World/Phase9Streetscape/Looks/LampPost/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.137, 0.145, 0.157)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.55
                    token outputs:surface
                }
            }
        }

